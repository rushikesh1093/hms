# Optional. Defaults to "/api", which the Vite dev server and nginx proxy to FastAPI.
# Only set this if the API is served from a different origin (then also set CORS_ORIGINS
# and COOKIE_SECURE=true on the backend, and serve both over HTTPS).
VITE_API_BASE_URL=
# Dev server proxy target (defaults to http://127.0.0.1:8000)
VITE_API_PROXY=
