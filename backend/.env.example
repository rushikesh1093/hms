# Copy to backend/.env and adjust. Never commit the real .env file.

# development | production | test
ENVIRONMENT=development

# PostgreSQL connection (SQLAlchemy URL using the psycopg 3 driver)
DATABASE_URL=postgresql+psycopg://hospital_app:change_me@localhost:5432/hospital_db
# Isolated database used ONLY by the automated test suite. Its name must contain "test".
TEST_DATABASE_URL=postgresql+psycopg://hospital_app:change_me@localhost:5432/hospital_test_db

# JWT signing secret. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
# Set to true when the app is served over HTTPS
COOKIE_SECURE=false

# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Login lockout policy
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15

# Hospital details printed on reports
HOSPITAL_NAME=Government District Hospital
HOSPITAL_ADDRESS=Department of Ophthalmology, Civil Lines, District Headquarters
HOSPITAL_PHONE=+91-0000-000000
TIMEZONE=Asia/Kolkata

# Demo account passwords used by `python -m app.seed` (development only).
# If left empty, the seed script generates random passwords and prints them once.
SEED_ADMIN_PASSWORD=
SEED_DOCTOR_PASSWORD=
SEED_RECEPTIONIST_PASSWORD=
