# Docker Compose settings. Copy to .env and replace every change_me value.
# Generate secrets with:  python -c "import secrets; print(secrets.token_urlsafe(64))"

POSTGRES_DB=hospital_db
POSTGRES_USER=hospital_app
POSTGRES_PASSWORD=change_me

SECRET_KEY=change_me_to_a_long_random_value_at_least_32_chars

# production | development  (seeding demo data is refused in production)
ENVIRONMENT=production
APP_PORT=8080
CORS_ORIGINS=http://localhost:8080
# true when served over HTTPS (required for real deployments)
COOKIE_SECURE=false

HOSPITAL_NAME=Government District Hospital
HOSPITAL_ADDRESS=Department of Ophthalmology, Civil Lines, District Headquarters
HOSPITAL_PHONE=+91-0000-000000
TIMEZONE=Asia/Kolkata

# Only used by `python -m app.seed` when ENVIRONMENT=development
SEED_ADMIN_PASSWORD=
SEED_DOCTOR_PASSWORD=
SEED_RECEPTIONIST_PASSWORD=
